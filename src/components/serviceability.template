<!-- HOME DELIVERY UNAVAILABLE MODAL -->
<div id="sd-serviceability-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-[9999] hidden items-center justify-center px-4">
    <div class="bg-white w-full max-w-sm rounded-2xl shadow-2xl p-6 text-center">

        <div class="mx-auto mb-4 w-12 h-12 rounded-full bg-red-100 flex items-center justify-center">
            <i class="fa-solid fa-location-dot text-red-600 text-xl"></i>
        </div>

        <h3 class="text-lg font-extrabold text-slate-900 mb-2">
            Home Delivery Unavailable
        </h3>

        <p class="text-sm text-slate-600 leading-relaxed mb-5">
            This location is not servicable for home delivery.
        </p>

        <button
            type="button"
            onclick="closeSDServiceabilityModal()"
            class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm py-2.5 rounded-xl transition">
            OK
        </button>

    </div>
</div>
