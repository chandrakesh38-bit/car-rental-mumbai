                </p>

                <span class="inline-flex items-center gap-1 text-[10px] font-bold text-indigo-600 mt-2">
                    View Details <i class="fa-solid fa-arrow-right text-[8px]"></i>
                </span>
            </button>


            <!-- CARD 5 -->
            <button type="button"
            onclick="openWhyChooseModal('support')"
            class="why-choose-card group col-span-2 md:col-span-1 md:col-start-auto px-3 py-5 sm:p-5 text-center hover:bg-indigo-50/50 transition-all duration-200 focus:outline-none focus:bg-indigo-50">

                <div class="mx-auto w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 group-hover:bg-indigo-100 flex items-center justify-center mb-3 transition">
                    <i class="fa-solid fa-headset text-base"></i>
                </div>

                <h3 class="font-bold text-slate-900 text-xs sm:text-sm leading-tight">
                    24/7 Support
                </h3>

                <p class="text-[10px] sm:text-[11px] text-slate-500 leading-relaxed mt-1">
                    Safety & round-the-clock support
                </p>

                <span class="inline-flex items-center gap-1 text-[10px] font-bold text-indigo-600 mt-2">
                    View Details <i class="fa-solid fa-arrow-right text-[8px]"></i>
                </span>
            </button>

        </div>

    </div>

</section>
