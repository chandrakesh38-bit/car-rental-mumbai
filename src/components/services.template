<!-- WHY CHOOSE US / FEATURE STRIP -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 py-8" id="services">

    <div class="text-center mb-5">
        <span class="bg-indigo-50 border border-indigo-100 text-indigo-800 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider inline-block mb-2">
            Why Choose Us
        </span>
        <h2 class="text-2xl font-black text-slate-900">
            Travel With Confidence
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
            Click any feature to know more about our service.
        </p>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">

        <div class="grid grid-cols-2 md:grid-cols-5 divide-x divide-y md:divide-y-0 divide-slate-200">

            <!-- CARD 1 -->
            <button type="button"
                onclick="openWhyChooseModal('driver')"
                class="why-choose-card group px-3 py-5 sm:p-5 text-center hover:bg-indigo-50/50 transition-all duration-200 focus:outline-none focus:bg-indigo-50">

                <div class="mx-auto w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 group-hover:bg-indigo-100 flex items-center justify-center mb-3 transition">
                    <i class="fa-solid fa-user-shield text-base"></i>
                </div>

                <h3 class="font-bold text-slate-900 text-xs sm:text-sm leading-tight">
                    Professional Driver
                </h3>

                <p class="text-[10px] sm:text-[11px] text-slate-500 leading-relaxed mt-1">
                    Verified & experienced chauffeurs
                </p>

                <span class="inline-flex items-center gap-1 text-[10px] font-bold text-indigo-600 mt-2">
                    View Details <i class="fa-solid fa-arrow-right text-[8px]"></i>
                </span>
            </button>


            <!-- CARD 2 -->
            <button type="button"
                onclick="openWhyChooseModal('pricing')"
                class="why-choose-card group px-3 py-5 sm:p-5 text-center hover:bg-indigo-50/50 transition-all duration-200 focus:outline-none focus:bg-indigo-50">

                <div class="mx-auto w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 group-hover:bg-indigo-100 flex items-center justify-center mb-3 transition">
                    <i class="fa-solid fa-receipt text-base"></i>
                </div>

                <h3 class="font-bold text-slate-900 text-xs sm:text-sm leading-tight">
                    Transparent Pricing
                </h3>

                <p class="text-[10px] sm:text-[11px] text-slate-500 leading-relaxed mt-1">
                    No hidden charges
                </p>

                <span class="inline-flex items-center gap-1 text-[10px] font-bold text-indigo-600 mt-2">
                    View Details <i class="fa-solid fa-arrow-right text-[8px]"></i>
                </span>
            </button>


            <!-- CARD 3 -->
            <button type="button"
                onclick="openWhyChooseModal('doorstep')"
                class="why-choose-card group px-3 py-5 sm:p-5 text-center hover:bg-indigo-50/50 transition-all duration-200 focus:outline-none focus:bg-indigo-50">

                <div class="mx-auto w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 group-hover:bg-indigo-100 flex items-center justify-center mb-3 transition">
                    <i class="fa-solid fa-house-chimney text-base"></i>
                </div>

                <h3 class="font-bold text-slate-900 text-xs sm:text-sm leading-tight">
                    Doorstep Delivery
                </h3>

                <p class="text-[10px] sm:text-[11px] text-slate-500 leading-relaxed mt-1">
                    Pickup & drop at your location
                </p>

                <span class="inline-flex items-center gap-1 text-[10px] font-bold text-indigo-600 mt-2">
                    View Details <i class="fa-solid fa-arrow-right text-[8px]"></i>
                </span>
            </button>


            <!-- CARD 4 -->
            <button type="button"
                onclick="openWhyChooseModal('fleet')"
                class="why-choose-card group px-3 py-5 sm:p-5 text-center hover:bg-indigo-50/50 transition-all duration-200 focus:outline-none focus:bg-indigo-50">

                <div class="mx-auto w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 group-hover:bg-indigo-100 flex items-center justify-center mb-3 transition">
                    <i class="fa-solid fa-car-side text-base"></i>
                </div>

                <h3 class="font-bold text-slate-900 text-xs sm:text-sm leading-tight">
                    Clean Fleet
                </h3>

                <p class="text-[10px] sm:text-[11px] text-slate-500 leading-relaxed mt-1">
